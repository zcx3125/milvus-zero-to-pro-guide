# Reference only: these Python examples read process environment variables.
# Copying this file to .env alone does NOT configure Python.
# PowerShell: $env:MILVUS_URI = "http://127.0.0.1:19530"
# Bash: export MILVUS_URI=http://127.0.0.1:19530
MILVUS_URI=http://127.0.0.1:19530
# Set a token only if the server requires it. Never commit a real token.
MILVUS_TOKEN=
